# Local developer configuration. Never commit .env.local or secrets.
# The model reader and natural voice need NO API keys.
KTTS_PRODUCTION=0
KTTS_ORIGIN=http://127.0.0.1:5173
KTTS_PAYPAL_SANDBOX=0
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# Vercel only: configure these in the correct Vercel environment.
# KTTS_ORIGIN must be the exact public HTTPS origin there.
# Leave DATABASE_URL blank for the local SQLite owner commands.
DATABASE_URL=
# Owner-controlled HTTPS asset-pack base; no model inference API is called.
KTTS_MODEL_BASE_URL=

# Vercel sandbox credentials/flag belong only to Preview.
# VERCEL_ENV is supplied by Vercel; do not override it.
# The Production adapter always disables sandbox payments.

# Additional setup; leave billing and outbound email closed until verified.
PAYPAL_SANDBOX_TAROT_PLAN_ID=
PAYPAL_SANDBOX_WEBHOOK_ID=
KTTS_SUBSCRIPTIONS_SANDBOX=0
KTTS_COMMERCE_SANDBOX=0
KTTS_PERSONAL_READINGS_READY=0
PAYPAL_LIVE_TAROT_PLAN_ID=
PAYPAL_LIVE_WEBHOOK_ID=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
KTTS_LIVE_CHECKOUT=0
KTTS_FULFILLMENT_JSON=
KTTS_LIVE_SUBSCRIPTIONS=0
KTTS_MEMBERSHIP_TAX_REVIEWED=0
KTTS_STORE_EMAIL=0
KTTS_ACCOUNT_RECOVERY=0
KTTS_SMTP_USERNAME=
KTTS_SMTP_PASSWORD=
KTTS_RECEIPT_SECRET=
CRON_SECRET=
